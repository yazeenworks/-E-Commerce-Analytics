usd,\n sum(gross_profit_usd) as gross_profit_usd,sum(refund_usd) as refund_usd\n from \"fuzzy\".\"main\".\"fct_orders\" group by 1\n)\nselect a.website_session_id,a.created_at,a.created_at::date as session_date,a.user_id,a.is_repeat_session,\n a.channel,a.campaign,a.device_type,coalesce(e.pageviews,0) as pageviews,\n coalesce(e.landing_page,'Unknown') as landing_page,case when e.pageviews=1 then 1 else 0 end as bounced,\n coalesce(o.orders,0) as orders,case when coalesce(o.orders,0)>0 then 1 else 0 end as converted_session,\n coalesce(o.revenue_usd,0) as revenue_usd,coalesce(o.gross_profit_usd,0) as gross_profit_usd,coalesce(o.refund_usd,0) as refund_usd,\n case when p is not null then 1 else 0 end as reached_products,\n case when p<c then 1 else 0 end as reached_cart,\n case when p<c and c<s then 1 else 0 end as reached_shipping,\n case when p<c and c<s and s<b then 1 else 0 end as reached_billing,\n case when p<c and c<s and s<b and b<t then 1 else 0 end as reached_thankyou\nfrom \"fuzzy\".\"main\".\"stg_sessions\" a left join page_events e using(website_session_id)\nleft join order_events o using(website_session_id)", "relation_name": "\"fuzzy\".\"main\".\"fct_sessions\"", "batch_results": null, "overload_results": null}, {"status": "pass", "timing": [{"name": "compile", "started_at": "2026-10-24T15:20:08.526170Z", "completed_at": "2026-10-24T15:20:08.529583Z"}, {"name": "execute", "started_at": "2026-10-24T15:20:08.529920Z", "completed_at": "2026-10-24T15:20:08.547341Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.02336859703063965, "adapter_response": {"_message": "OK"}, "message": null, "failures": 0, "unique_id": "test.fuzzy_factory.funnel_monotonic", "compiled": true, "compiled_code": "select website_session_id from \"fuzzy\".\"main\".\"fct_sessions\" where reached_thankyou>reached_billing or reached_billing>reached_shipping or reached_shipping>reached_cart or reached_cart>reached_products", "relation_name": null, "batch_results": null, "overload